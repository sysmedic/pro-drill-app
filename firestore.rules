rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // [함수] 관리자 식별 (마스터 계정)
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['sysmedic@gmail.com'];
    }

    // [함수] 사용자의 서비스 이용 가능 상태 확인
    function isUserActive() {
      // users 컬렉션에서 해당 이메일 문서의 status가 active인지 확인
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.status == 'active';
    }

    // 1. 사용자 관리 (users)
    match /users/{userEmail} {
      allow read: if request.auth != null && (request.auth.token.email == userEmail || isAdmin());

      // 가입 시: TRIAL_BETA 등급, 기기 2대 기본값 강제
      allow create: if request.auth != null 
                     && request.auth.token.email == userEmail
                     && request.resource.data.tier == 'trial_beta'
                     && request.resource.data.maxDevices == 2
                     && request.resource.data.status == 'active';

      // 수정 시: 관리자는 MASTER(5대) 포함 모든 변경 가능 / 일반인은 기기 등록만 가능
      allow update: if request.auth != null && (
        isAdmin() || 
        (request.auth.token.email == userEmail
         && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['tier', 'status', 'maxDevices', 'joinedAt', 'uid', 'email'])
         && request.resource.data.activeDevices.size() <= resource.data.maxDevices)
      );

      allow delete: if request.auth != null && (request.auth.token.email == userEmail || isAdmin());
    }

    // 2. 고객 데이터 (customers) - 스크린샷 기반
    match /customers/{customerId} {
      allow read, write: if request.auth != null && (isAdmin() || isUserActive());
    }

    // 3. 지침 차트 (drilling_charts) - 스크린샷의 언더바(_) 형식 반영
    match /drilling_charts/{chartId} {
      allow read, write: if request.auth != null && (isAdmin() || isUserActive());
    }

    // 4. 베타 유저 목록 (beta_users) - 스크린샷 기반
    match /beta_users/{docId} {
      allow read, write: if isAdmin(); // 베타 관리는 마스터만
    }

    // 5. 활성화 체크용 (isActive) - 스크린샷 기반
    match /isActive/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}